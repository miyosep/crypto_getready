# Optional browser-visible overrides. The public contract address, deployment
# block, and NFT setting default to deployment/practice-config.json.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: lower this if your RPC has a small eth_getLogs block limit (e.g. 10).
NEXT_PUBLIC_LOG_CHUNK_SIZE=2000
NEXT_PUBLIC_GOOGLE_FAUCET_URL=https://cloud.google.com/application/web3/faucet/ethereum/sepolia
NEXT_PUBLIC_FAUCET_DIRECTORY_URL=https://ethereum.org/en/developers/docs/networks/#sepolia

# Deployment/organizer-only. Do not prefix these with NEXT_PUBLIC_.
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
